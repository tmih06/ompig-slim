#!/usr/bin/env bash
# Pre-commit quality gate (installed via `git config core.hooksPath .githooks`
# or `make hooks`). Runs the fast quality gate before every commit so broken
# code, lint regressions, and AI slop cannot enter local history.
#
# Escape hatch for emergencies only: `git commit --no-verify` (CI still
# enforces the full `make gate` on every PR and push).
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

export PATH="$PATH:$(go env GOPATH 2>/dev/null || echo "$HOME/go")/bin:$HOME/.local/bin"

# Skip when nothing is staged (e.g. `git commit --allow-empty` or amend without changes).
if git diff --cached --quiet; then
    exit 0
fi

exec bash scripts/quality/gate.sh --quick
